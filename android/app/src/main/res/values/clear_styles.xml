<?xml version="1.0" ?>
<resources>
    <style name="ClearButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/clear_button</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="ClearNav" parent="ClearButton">
        <item name="android:textSize">12sp</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">@drawable/nav_background</item>
    </style>
</resources>
