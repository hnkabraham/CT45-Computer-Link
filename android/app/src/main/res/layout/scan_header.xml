<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/status_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/connection_more"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/more_options"
                android:textAllCaps="false"
                android:textColor="@color/accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/waiting_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/pending"
            android:textSize="15sp"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/session_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <!-- Filled buttons make the connection and session actions easy to discover. -->
            <Button
                android:id="@+id/connection_mode"
                tools:ignore="ButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/change_connection"
                android:textAllCaps="false"
                android:textSize="12sp" />
            <Button
                android:id="@+id/session_mode"
                tools:ignore="ButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/change_session"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/session_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
        <Button
            android:id="@+id/use_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/use_network"
            android:textAllCaps="false"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/connection_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/retry_now"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/retry_now"
                android:textAllCaps="false"
                android:textColor="@color/accent" />
            <Button
                android:id="@+id/connection_help"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/connection_help"
                android:textAllCaps="false"
                android:textColor="@color/accent" />
        </LinearLayout>
        <TextView
            android:id="@+id/session_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pending"
            android:textSize="13sp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/settings_toggle"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/scanning_settings"
        android:textAllCaps="false"
        android:textColor="@color/accent" />

    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/background_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/background_title"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/background_hint"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/background_title"
                android:minHeight="48dp" />
        </LinearLayout>

        <Button
            android:id="@+id/feedback_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/delivery_feedback"
            android:textAllCaps="false" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/feedback_hint"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/storage_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/warn_banner"
        android:padding="12dp"
        android:text="@string/storage_error_detail"
        android:textColor="@color/warn_text"
        android:textSize="14sp"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <TextView
        android:id="@+id/scanner_missing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/warn_banner"
        android:padding="12dp"
        android:text="@string/scanner_missing"
        android:textColor="@color/warn_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/last_scan"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/last_scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/text"
        android:textIsSelectable="true"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/last_scan_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp"
        android:text="@string/recent"
        android:textColor="@color/muted"
        android:textSize="13sp" />


</LinearLayout>
