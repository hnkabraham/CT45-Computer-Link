<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/clear_logo"
            android:background="@drawable/app_logo_frame"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:textColor="@color/text" />
        <Button
            android:id="@+id/connection_more"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="64dp"
            android:text="@string/more_options"
            android:textAllCaps="false"
            android:textColor="@color/accent" />
    </LinearLayout>
    <ListView
        android:id="@+id/recent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:divider="@color/border"
        android:dividerHeight="1dp"
        android:headerDividersEnabled="false" />
    <LinearLayout
        android:id="@+id/manual_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <EditText
            android:id="@+id/manual"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/manual_hint"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:minHeight="48dp"
            android:textSize="15sp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />
        <Button
            android:id="@+id/send"
            style="@style/ClearButton"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/accent"
            android:text="@string/send"
            android:textColor="@color/on_accent" />
        <Button
            android:id="@+id/manual_close"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:padding="0dp"
            android:text="@string/close_entry"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/accent" />
    </LinearLayout>
    <Button
        android:id="@+id/manual_toggle"
        style="@style/ClearButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/enter_barcode" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/nav_scan"
            style="@style/ClearNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_scan"
            android:text="@string/nav_scan" />
        <Button
            android:id="@+id/nav_history"
            style="@style/ClearNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_history"
            android:text="@string/nav_history" />
        <Button
            android:id="@+id/settings_toggle"
            style="@style/ClearNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_settings"
            android:text="@string/nav_settings" />
    </LinearLayout>
</LinearLayout>
